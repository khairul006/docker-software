@NonCPS
def parseServers(String jsonText) {
    def slurper = new groovy.json.JsonSlurperClassic()
    return slurper.parseText(jsonText)
}

pipeline {
    agent any
    stages {
        stage('Ping Plazas') {
            steps {
                script {
                    def jsonText = readFile("${WORKSPACE}/jenkins/pipelines/config/servers.json")
                    // Note: SCM checkout puts THIS repo's files in WORKSPACE,
                    // so config/servers.json needs to be inside the same repo checkout.
                    // See Step 2 note below — we'll fix the path there.
                    def servers = parseServers(jsonText)
                    for (s in servers) {
                        pwsh """
                            \$result = Test-Connection -ComputerName '${s.ip}' -Count 2 -ErrorAction SilentlyContinue
                            if (\$result) {
                                Write-Host "[OK] ${s.name} (${s.ip}) is reachable"
                            } else {
                                Write-Host "[FAIL] ${s.name} (${s.ip}) is NOT reachable"
                            }
                        """
                    }
                }
            }
        }
    }
}